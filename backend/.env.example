APP_NAME="Workspace SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin of the React SPA. Used for CORS and for building invitation links.
# Comma-separate the list if more than one origin needs access.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Create the database before running `php artisan migrate`.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=workspace_saas
DB_USERNAME=laravel_user
DB_PASSWORD=


# Sanctum SPA (cookie/session) authentication.
# Hosts listed here receive a stateful session cookie instead of a bearer token.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot shares the cookie across subdomains; keep "localhost" for local dev.
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
# Set to true once the app is served over HTTPS.
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local default is Mailpit, a mail catcher that accepts everything and shows
# it at http://localhost:8025 — nothing leaves your machine. Start it with:
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# Use MAIL_MAILER=log to write emails to storage/logs instead, or a provider
# such as postmark/resend/ses to deliver them for real.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
